# Copy this file to .env and adjust if needed.
# Matches the database started by docker-compose.yml.
DATABASE_URL="postgresql://task_editor:task_editor@localhost:5432/task_editor?schema=public"

# Secret used to sign login cookies. At least 32 characters.
# Make a new one with:  openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-of-32-plus-chars"

# Optional: Anthropic API key for "Import from PDF" (Learning → Import from PDF).
# Create one at console.anthropic.com → API keys. Billed per use.
# ANTHROPIC_API_KEY="sk-ant-..."
