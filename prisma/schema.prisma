// Database schema for Task Editor.
// Matches the data model in docs/PLAN.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  DONE
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum RecurrenceRule {
  DAILY
  WEEKDAYS
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  // Goes up when the password changes or "log out everywhere" is used;
  // login cookies with an older number stop working.
  sessionVersion Int    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  color       String        @default("#3b82f6")
  startDate   DateTime?     @db.Date
  dueDate     DateTime?     @db.Date
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks          Task[]
  recurringTasks RecurringTask[]
  timeLogs       TimeLog[]
}

model LearningPath {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      ProjectStatus @default(ACTIVE)
  color       String        @default("#10b981")
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  steps          LearningStep[]
  milestones     Milestone[]
  tasks          Task[]
  recurringTasks RecurringTask[]
  timeLogs       TimeLog[]
}

// A stage of a learning path (e.g. a chapter or module) that groups its steps.
model Milestone {
  id             String       @id @default(cuid())
  learningPathId String
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  order          Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  steps LearningStep[]

  @@index([learningPathId, order])
}

// A step ("level") of a learning path, optionally inside a milestone.
model LearningStep {
  id              String       @id @default(cuid())
  learningPathId  String
  learningPath    LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  // Deleting a milestone keeps its steps; they move to "Other steps".
  milestoneId     String?
  milestone       Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title           String
  order           Int
  done            Boolean      @default(false)
  doneAt          DateTime?
  resourceUrl     String?
  notes           String?
  estimateMinutes Int?
  difficulty      Difficulty?
  // Where it is in the source, e.g. "pp. 12–20" (from PDF import).
  pages           String?
  // An earlier step that already covered this one (found by PDF import).
  coveredById     String?
  coveredBy       LearningStep?  @relation("CoveredBy", fields: [coveredById], references: [id], onDelete: SetNull)
  covers          LearningStep[] @relation("CoveredBy")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([learningPathId, order])
  @@index([milestoneId])
}

model Task {
  id              String     @id @default(cuid())
  title           String
  notes           String?
  date            DateTime   @db.Date
  status          TaskStatus @default(TODO)
  priority        Priority   @default(MEDIUM)
  estimateMinutes Int?
  difficulty      Difficulty?
  // Set by "Plan my day": start time in minutes after midnight (540 = 09:00).
  plannedStart    Int?
  // Created by "Plan my day" (removed again if you re-plan and it isn't done).
  fromPlan        Boolean    @default(false)
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  learningPathId  String?
  learningPath    LearningPath?  @relation(fields: [learningPathId], references: [id], onDelete: SetNull)
  recurringTaskId String?
  recurringTask   RecurringTask? @relation(fields: [recurringTaskId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([status])
  // A recurring task creates at most one task per day.
  @@unique([recurringTaskId, date])
}

model RecurringTask {
  id              String         @id @default(cuid())
  title           String
  notes           String?
  rule            RecurrenceRule @default(DAILY)
  priority        Priority       @default(MEDIUM)
  estimateMinutes Int?
  active          Boolean        @default(true)
  // The last day this template added its task to the list. Stops a task
  // you deleted from coming back the same day.
  lastCreatedOn   DateTime?      @db.Date
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  learningPathId String?
  learningPath   LearningPath? @relation(fields: [learningPathId], references: [id], onDelete: SetNull)

  tasks Task[]
}

model TimeLog {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  minutes   Int
  note      String?
  createdAt DateTime @default(now())

  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  learningPathId String?
  learningPath   LearningPath? @relation(fields: [learningPathId], references: [id], onDelete: SetNull)

  @@index([date])
}

// A day's schedule from "Plan my day": the timed blocks (work, breaks,
// prayers, lunch) as JSON. One per day.
model DayPlan {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  blocks    Json
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Settings for "Plan my day" (one row, id "default"). Times are minutes after midnight.
model PlannerSettings {
  id             String   @id @default("default")
  dayStart       Int      @default(540)
  dayEnd         Int      @default(1020)
  maxBlock       Int      @default(90)
  breakMinutes   Int      @default(15)
  lunchStart     Int      @default(780)
  lunchMinutes   Int      @default(30)
  prayersEnabled Boolean  @default(true)
  locationName   String   @default("Cairo")
  latitude       Float    @default(30.0444)
  longitude      Float    @default(31.2357)
  timeZone       String   @default("Africa/Cairo")
  method         String   @default("Egyptian")
  asrMethod      String   @default("Standard")
  prayerMinutes  Int      @default(15)
  updatedAt      DateTime @updatedAt
}
